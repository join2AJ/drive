{
  "name": "drive-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile app for wired GPS trackers: live tracking, trips, speed insights, frequent places, crash detection, dashcam & cabin audio vault.",
  "scripts": {
    "dev": "vite --host",
    "docs": "node scripts/build-docs.mjs",
    "prebuild": "npm run docs",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "cap:sync": "vite build && cap sync",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "marked": "^18.0.14",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
